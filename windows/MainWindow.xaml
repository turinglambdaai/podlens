<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Layout mirrors Apple Podcasts: a NavigationView sidebar (Home /
      Discover / Library pages / subscriptions with cover art) feeding a
      page column and a persistent detail column, with the player bar
      riding the whole window. All list content is built in code
      (MainWindow.xaml.cpp) because the C++/WinRT host has no x:Bind
      surface; this file owns structure only.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView Grid.Row="0"
                        x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="264"
                        SelectionChanged="Nav_SelectionChanged"
                        ItemInvoked="Nav_ItemInvoked">

            <NavigationView.PaneHeader>
                <StackPanel Margin="16,12,16,8" Spacing="4">
                    <TextBlock Text="PodLens" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock x:Name="SubtitleText" FontSize="12" Opacity="0.75" />
                    <Button x:Name="AddFeedButton" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Click="AddFeed_Click" />
                    <Button x:Name="HelpButton" HorizontalAlignment="Stretch">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuCheckUpdates" Click="CheckUpdates_Click">
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="U" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuRefreshAll" Click="RefreshAll_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuAbout" Click="MenuAbout_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Tag="settings" IsSelected="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Name="SettingsNavLabel" />
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="ContentLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="430" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <!-- page column: exactly one child is visible at a time -->
                <Grid Grid.Column="0" x:Name="PageColumn">
                    <!-- home -->
                    <ScrollViewer x:Name="HomePage" Visibility="Visible">
                        <StackPanel x:Name="HomeList" MaxWidth="620"
                                    HorizontalAlignment="Left" Spacing="4"
                                    Margin="16,4,16,16" />
                    </ScrollViewer>

                    <!-- discover: directory search above the curated list -->
                    <Grid x:Name="DiscoverView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    Spacing="8" Margin="16,12,16,4">
                            <TextBox x:Name="DiscoverSearchBox" Width="360"
                                     KeyDown="DiscoverSearch_KeyDown" />
                            <Button x:Name="DiscoverSearchButton"
                                    Click="DiscoverSearch_Click">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel x:Name="DiscoverList" MaxWidth="620"
                                        HorizontalAlignment="Left" Spacing="4"
                                        Margin="16,8,16,16" />
                        </ScrollViewer>
                    </Grid>

                    <!-- recently updated -->
                    <ScrollViewer x:Name="RecentPage" Visibility="Collapsed">
                        <StackPanel x:Name="RecentList" MaxWidth="620"
                                    HorizontalAlignment="Left" Spacing="4"
                                    Margin="16,8,16,16" />
                    </ScrollViewer>

                    <!-- shows grid -->
                    <ScrollViewer x:Name="ShowsPage" Visibility="Collapsed">
                        <GridView x:Name="ShowsGrid" Margin="8,8,8,16"
                                  SelectionMode="Single" />
                    </ScrollViewer>

                    <!-- downloaded -->
                    <ScrollViewer x:Name="DownloadedPage" Visibility="Collapsed">
                        <StackPanel x:Name="DownloadedList" MaxWidth="620"
                                    HorizontalAlignment="Left" Spacing="4"
                                    Margin="16,8,16,16" />
                    </ScrollViewer>

                    <!-- one feed's episodes -->
                    <Grid x:Name="EpisodesPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,12,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EpisodesHeader" FontWeight="SemiBold" FontSize="14" />
                            <Button Grid.Column="1" x:Name="RefreshFeedButton" Background="Transparent"
                                    BorderThickness="0" Padding="6" Click="RefreshFeed_Click">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" x:Name="RemoveFeedButton" Background="Transparent"
                                    BorderThickness="0" Padding="6" Click="RemoveFeed_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="EpisodeList" Margin="12,0"
                                  SelectionMode="Single"
                                  SelectionChanged="EpisodeList_SelectionChanged" />

                        <StackPanel Grid.Row="1" x:Name="EpisodesEmpty" Margin="24,48,24,0"
                                    Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="EpisodesEmptyTitle" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock x:Name="EpisodesEmptyHint" FontSize="13" Opacity="0.7"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" x:Name="ContentDivider" Width="1" Margin="0,8"
                        Background="{ThemeResource AppLineBrush}" />

                <!-- detail -->
                <Grid Grid.Column="2" x:Name="DetailColumn" Padding="20,12,20,12">
                    <!-- nothing selected -->
                    <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="10" MaxWidth="360">
                        <FontIcon Glyph="&#xE720;" FontSize="40"
                                  Foreground="{ThemeResource AppAccentBrush}" />
                        <TextBlock x:Name="DetailEmptyTitle" HorizontalAlignment="Center"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailEmptyHint" HorizontalAlignment="Center"
                                   TextAlignment="Center" FontSize="13" Opacity="0.7"
                                   TextWrapping="Wrap" />
                        <Button x:Name="DetailEmptyCta" HorizontalAlignment="Center"
                                Background="{ThemeResource AppAccentBrush}"
                                Foreground="White" BorderThickness="0" />
                    </StackPanel>

                    <!-- episode detail -->
                    <Grid x:Name="DetailViewHost" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
                            <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailMeta" FontSize="13"
                                       Foreground="{ThemeResource AppInkSoftBrush}" />
                            <!-- show notes straight from the feed's episode description -->
                            <TextBlock x:Name="DetailNotes" FontSize="12" Opacity="0.7"
                                       TextWrapping="Wrap" MaxLines="3"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailEstimate" FontSize="11" Opacity="0.55" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Left" Margin="0,4,0,8">
                            <Button x:Name="PipelineButton" Padding="10,4" Click="Pipeline_Click"
                                    Background="{ThemeResource AppAccentBrush}" Foreground="White"
                                    BorderThickness="0" />
                            <Button x:Name="MoreButton" Padding="10,4">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="MenuDownload" Click="Download_Click" />
                                        <MenuFlyoutItem x:Name="MenuTranscribe" Click="Transcribe_Click" />
                                        <MenuFlyoutItem x:Name="MenuTranslate" Click="Translate_Click" />
                                        <MenuFlyoutItem x:Name="MenuSummarize" Click="Summarize_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MenuMark" Click="MarkMenu_Click" />
                                        <MenuFlyoutItem x:Name="MenuRemoveAudio" Click="RemoveAudio_Click"
                                                        Visibility="Collapsed" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <ToggleButton x:Name="FocusModeButton" Padding="10,4"
                                          Click="FocusMode_Click" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center" Margin="0,0,0,6">
                            <ToggleButton x:Name="TranscriptTab" Click="TranscriptTab_Click" />
                            <ToggleButton x:Name="SummaryTab" Click="SummaryTab_Click" />
                            <TextBlock x:Name="ModeLabel" Margin="18,0,6,0" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.7" />
                            <ComboBox x:Name="ModeSelector" MinWidth="110"
                                       SelectionChanged="Mode_SelectionChanged" />
                            <ToggleButton x:Name="FollowTranscriptButton" Margin="12,0,0,0"
                                          IsChecked="True" Click="FollowTranscript_Click" />
                            <Button x:Name="ReturnToCurrentButton"
                                    Click="ReturnToCurrent_Click" />
                        </StackPanel>

                        <ListView Grid.Row="3" x:Name="TranscriptList"
                                  SelectionMode="None" IsItemClickEnabled="False" />

                        <ScrollViewer Grid.Row="3" x:Name="SummaryView" Visibility="Collapsed">
                            <StackPanel x:Name="SummaryList" MaxWidth="720" HorizontalAlignment="Left"
                                        Spacing="16" Margin="0,4,12,24" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <Border Grid.Row="1" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource AppLineBrush}" Padding="16,3">
            <TextBlock x:Name="StatusLine" FontSize="11" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource AppInkSoftBrush}" Text="" />
        </Border>

        <InfoBar Grid.Row="2" x:Name="ErrorBar" IsOpen="False" IsClosable="True"
                 Severity="Error" Message="…" Margin="12,4" />

        <!-- persistent player bar -->
        <Border Grid.Row="3" x:Name="PlayerBar" Visibility="Collapsed"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AppLineBrush}"
                Background="{ThemeResource AppCardBrush}" Padding="16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.KeyboardAccelerators>
                    <!--
                      Space toggles playback and Ctrl+Left/Right seek; the
                      handler ignores keystrokes while a TextBox owns focus
                      so typing a feed URL is unaffected.
                    -->
                    <KeyboardAccelerator Key="Space" Modifiers="None"
                                         Invoked="PlayerAccel_Invoked" />
                    <KeyboardAccelerator Key="Left" Modifiers="Control"
                                         Invoked="PlayerAccel_Invoked" />
                    <KeyboardAccelerator Key="Right" Modifiers="Control"
                                         Invoked="PlayerAccel_Invoked" />
                </Grid.KeyboardAccelerators>

                <Border Grid.Column="0" x:Name="PlayerArtworkHost" Width="40" Height="40"
                        CornerRadius="6" Background="{ThemeResource AppAccentSoftBrush}">
                    <Image x:Name="PlayerArtwork" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="PlayerTitle" FontSize="12" FontWeight="SemiBold"
                               MaxLines="1" TextTrimming="CharacterEllipsis" Text="" />
                    <TextBlock x:Name="PlayerShow" FontSize="11" Opacity="0.7"
                               MaxLines="1" TextTrimming="CharacterEllipsis" Text="" />
                </StackPanel>

                <!-- PodLens' edge: jump straight into the transcript reader -->
                <Button Grid.Column="2" x:Name="TranscriptButton" Width="36" Height="36"
                        CornerRadius="18" Background="Transparent" BorderThickness="0"
                        Padding="0" Click="TranscriptTab_Click">
                    <FontIcon Glyph="&#xE8E9;" FontSize="14" />
                </Button>

                <Button Grid.Column="3" x:Name="SleepButton" Width="36" Height="36"
                        CornerRadius="18" Background="Transparent" BorderThickness="0"
                        Padding="0">
                    <FontIcon Glyph="&#xE708;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <!-- texts are filled from the i18n table in the
                                 constructor; Tag is the duration in minutes
                                 (0 = off) -->
                            <MenuFlyoutItem Tag="0" Click="SleepOption_Click" />
                            <MenuFlyoutItem Tag="5" Click="SleepOption_Click" />
                            <MenuFlyoutItem Tag="10" Click="SleepOption_Click" />
                            <MenuFlyoutItem Tag="15" Click="SleepOption_Click" />
                            <MenuFlyoutItem Tag="30" Click="SleepOption_Click" />
                            <MenuFlyoutItem Tag="45" Click="SleepOption_Click" />
                            <MenuFlyoutItem Tag="60" Click="SleepOption_Click" />
                            <MenuFlyoutItem Tag="90" Click="SleepOption_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- chapter marks: hidden unless the episode carries chapters -->
                <Button Grid.Column="4" x:Name="ChapterBackButton" Width="36" Height="36"
                        CornerRadius="18" Background="Transparent" BorderThickness="0"
                        Padding="0" Visibility="Collapsed" Click="ChapterBack_Click">
                    <FontIcon Glyph="&#xE915;" FontSize="13" />
                </Button>
                <Button Grid.Column="5" x:Name="ChapterForwardButton" Width="36" Height="36"
                        CornerRadius="18" Background="Transparent" BorderThickness="0"
                        Padding="0" Visibility="Collapsed" Click="ChapterForward_Click">
                    <FontIcon Glyph="&#xE916;" FontSize="13" />
                </Button>

                <Button Grid.Column="6" x:Name="SkipBackButton" Width="36" Height="36"
                        CornerRadius="18" Background="Transparent" BorderThickness="0"
                        Padding="0" Click="SkipBack_Click">
                    <FontIcon Glyph="&#xEB9E;" FontSize="14" />
                </Button>

                <Button Grid.Column="7" x:Name="PlayPauseButton" Width="40" Height="40"
                        CornerRadius="20" Background="{ThemeResource AppAccentBrush}"
                        Foreground="White" BorderThickness="0" Click="PlayPause_Click">
                    <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="16" />
                </Button>

                <Button Grid.Column="8" x:Name="SkipForwardButton" Width="36" Height="36"
                        CornerRadius="18" Background="Transparent" BorderThickness="0"
                        Padding="0" Click="SkipForward_Click">
                    <FontIcon Glyph="&#xEB9D;" FontSize="14" />
                </Button>

                <TextBlock Grid.Column="9" x:Name="PositionText" FontSize="12"
                           FontFamily="Consolas" VerticalAlignment="Center" Text="00:00" />
                <Slider Grid.Column="10" x:Name="SeekSlider" Minimum="0" Maximum="100"
                        StepFrequency="1" VerticalAlignment="Center"
                        ValueChanged="SeekSlider_ValueChanged"
                        PointerPressed="SeekSlider_PointerPressed"
                        PointerCaptureLost="SeekSlider_PointerReleased"
                        PointerReleased="SeekSlider_PointerReleased" />
                <TextBlock Grid.Column="11" x:Name="DurationText" FontSize="12"
                           FontFamily="Consolas" VerticalAlignment="Center" Text="00:00" />
                <ComboBox Grid.Column="12" x:Name="RateSelector" MinWidth="92"
                          VerticalAlignment="Center" SelectionChanged="Rate_SelectionChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
